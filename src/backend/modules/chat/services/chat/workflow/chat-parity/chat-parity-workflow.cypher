(executionMerge:merge {"name":"Merge Execution Routes","runtime":{}})
(normalizeActions:code {"name":"Normalize Planned Actions","runtime":{"code":"const objects = [];\nconst collect = (value) => {\n  if (!value || typeof value !== 'object') return;\n  objects.push(value);\n  const values = Array.isArray(value) ? value : Object.values(value);\n  values.forEach((entry) => collect(entry));\n};\ncollect(input);\nconst payload = objects.find((entry) => (entry.route === 'execute_confirmed' || entry.route === 'execute_now') && entry.plan && Array.isArray(entry.plan.actions)) || objects.find((entry) => entry && entry.plan && Array.isArray(entry.plan.actions)) || objects.find((entry) => entry && Array.isArray(entry.actions)) || {};\nconst plan = payload.plan && Array.isArray(payload.plan.actions) ? payload.plan : payload;\nconst meta = workflow.metadata || {};\nconst subjectIds = Array.isArray(meta.subjectIds) ? meta.subjectIds : [];\nconst postIds = Array.isArray(meta.postIds) ? meta.postIds : [];\nconst groups = { 'run-channel-action': ['read_channel', 'create_channel', 'update_channel', 'delete_channel', 'link_channel'], 'run-category-action': ['read_category', 'create_category', 'update_category', 'delete_category', 'link_category'], 'run-subject-action': ['read_subject', 'create_subject', 'update_subject', 'delete_subject', 'link_subject', 'sync_subject_references_from_web', 'refresh_subject_metadata_links'], 'run-post-action': ['read_post', 'read_attachments', 'create_post', 'update_post', 'delete_post', 'link_post'], 'run-user-tree-action': ['fetch_user_tree'], 'run-chat-action': ['search_web_with_tags', 'retrieve_db_chunks_and_analyze', 'search_cross_subject_knowledge', 'scan_user_chats', 'extract_llm_background_knowledge'] };\nconst nodes = Array.isArray(workflow.nodes) ? workflow.nodes : [];\nconst routerByGroup = Object.fromEntries(nodes.filter((node) => node.modelId === 'action-router').map((node) => [String(node.runtime?.broadcastModelId || '').trim(), node.id]));\nconst nodeByModel = Object.fromEntries(nodes.map((node) => [String(node.modelId || '').trim(), String(node.id || '').trim()]));\nconst modelById = Object.fromEntries(nodes.map((node) => [String(node.id || '').trim(), String(node.modelId || '').trim()]));\nconst normalizeCypher = (value) => {\n  let text = String(value || '').trim();\n  if (!text) return text;\n  text = text.replace(/^CREATE\\s+/i, '').replace(/\\s+RETURN\\s+[\\s\\S]*$/i, '').trim();\n  text = text.replace(/\\s+CREATE\\s+/gi, '\\n');\n  text = text.replace(/([A-Za-z_][\\w-]*)\\.(?:out|output):(?:output)/g, '$1.output');\n  text = text.replace(/([A-Za-z_][\\w-]*)\\.(?:in|input):(?:input)/g, '$1.input');\n  text = text.replace(/,?\\s*CONNECT\\s+([A-Za-z_][\\w-]*)(?:[.:](?:output|out))\\s+TO\\s+([A-Za-z_][\\w-]*)(?:[.:](?:input|in))/gi, (_match, from, to) => `\\n(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/,?\\s*CONNECT\\s+([A-Za-z_][\\w-]*)(?:[.:](?:output|out))?\\s*->\\s*([A-Za-z_][\\w-]*)(?:[.:](?:input|in))?/gi, (_match, from, to) => `\\n(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/\\{\\s*out:\\s*\\\"([^\\\"]+)\\\"\\s*,\\s*in:\\s*\\\"([^\\\"]+)\\\"\\s*\\}/g, (_match, sourcePort, targetPort) => `{\\\"source\\\":\\\"out:${sourcePort}\\\",\\\"target\\\":\\\"in:${targetPort}\\\"}`);\n  text = text.replace(/\\(([A-Za-z_][\\w-]*)\\)-\\[:(?:CONNECT|NEXT)\\]->\\(([A-Za-z_][\\w-]*)\\)/g, (_match, from, to) => `(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/([A-Za-z_][\\w-]*)-\\[:(?:CONNECT|NEXT)\\]->([A-Za-z_][\\w-]*)/g, (_match, from, to) => `(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/\\),\\s+\\(/g, ')\\n(');\n  text = text.replace(/\\)\\s+\\(([A-Za-z_][\\w-]*:)/g, ')\\n($1');\n  text = text.replace(/,\\s*([A-Za-z_][\\w-]*)(?:[.:](?:output|out))?\\s*->\\s*([A-Za-z_][\\w-]*)(?:[.:](?:input|in))?/g, (_match, from, to) => `\\n(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  return text;\n};\nconst normalizeWorkflowInput = (value) => {\n  const nextInput = { ...value };\n  if (nextInput.name && !nextInput.workflowName) nextInput.workflowName = nextInput.name;\n  if (nextInput.description && !nextInput.workflowDescription) nextInput.workflowDescription = nextInput.description;\n  if (nextInput.workflow_id && !nextInput.workflowId) nextInput.workflowId = nextInput.workflow_id;\n  if (nextInput.workflow_action_id && !nextInput.workflowActionId) nextInput.workflowActionId = nextInput.workflow_action_id;\n  if (nextInput.cypher) nextInput.cypher = normalizeCypher(nextInput.cypher);\n  if (!nextInput.operation) nextInput.operation = 'save';\n  if (!nextInput.saveMode && nextInput.operation === 'save') nextInput.saveMode = 'create';\n  if (!nextInput.definitionSource && nextInput.operation === 'save') nextInput.definitionSource = 'cypher';\n  return nextInput;\n};\nconst actions = (Array.isArray(plan.actions) ? plan.actions : []).map((entry, index) => {\n  const action = entry || {};\n  const explicitName = String(action.name || action.action || action.input?.action || '').trim();\n  const nextInput = { ...(action.actionInput || action.input?.actionInput || (action.input?.action ? {} : action.input || {})) };\n  if ((explicitName === 'read_channel' || explicitName === 'update_channel' || explicitName === 'delete_channel') && !nextInput.id && (nextInput.channelId || meta.channelId)) nextInput.id = nextInput.channelId || meta.channelId;\n  if ((explicitName === 'read_category' || explicitName === 'update_category' || explicitName === 'delete_category') && !nextInput.id && (nextInput.categoryId || meta.categoryId)) nextInput.id = nextInput.categoryId || meta.categoryId;\n  if ((explicitName === 'read_subject' || explicitName === 'update_subject' || explicitName === 'delete_subject' || explicitName === 'refresh_subject_metadata_links' || explicitName === 'sync_subject_references_from_web') && !nextInput.id && (nextInput.subjectId || subjectIds[0])) nextInput.id = nextInput.subjectId || subjectIds[0];\n  if ((explicitName === 'read_post' || explicitName === 'update_post' || explicitName === 'delete_post') && !nextInput.id && (nextInput.postId || postIds[0])) nextInput.id = nextInput.postId || postIds[0];\n  if (explicitName === 'read_attachments' && !nextInput.post_id && (nextInput.postId || postIds[0])) nextInput.post_id = nextInput.postId || postIds[0];\n  const directNodeId = String(action.nodeId || '').trim();\n  const directModelId = String(modelById[directNodeId] || '').trim();\n  const groupId = Object.keys(groups).find((modelId) => groups[modelId].includes(explicitName)) || '';\n  const nodeId = directNodeId || routerByGroup[groupId] || (explicitName === 'Workflow' ? nodeByModel.workflow : '') || ((explicitName === 'Execute Workflow' || explicitName === 'execute_workflow' || explicitName === 'get_workflow_output') ? nodeByModel['execute-workflow'] : '');\n  const modelId = String(modelById[nodeId] || directModelId || '').trim();\n  if (!nodeId) throw new Error(`No workflow tool is available for ${explicitName || 'unknown action'}.`);\n  if (modelId === 'workflow') return { id: String(action.id || `a${index + 1}`), nodeId, kind: 'tool', name: 'Workflow', reason: String(action.reason || 'Workflow planned action.'), input: normalizeWorkflowInput(nextInput), depends_on: Array.isArray(action.depends_on) ? action.depends_on : [] };\n  if (modelId === 'execute-workflow') {\n    if (nextInput.workflow_id && !nextInput.workflowId) nextInput.workflowId = nextInput.workflow_id;\n    if (nextInput.workflow_action_id && !nextInput.workflowActionId) nextInput.workflowActionId = nextInput.workflow_action_id;\n    return { id: String(action.id || `a${index + 1}`), nodeId, kind: 'tool', name: 'Execute Workflow', reason: String(action.reason || 'Workflow planned action.'), input: nextInput, depends_on: Array.isArray(action.depends_on) ? action.depends_on : [] };\n  }\n  return { id: String(action.id || `a${index + 1}`), nodeId, kind: 'tool', name: explicitName, reason: String(action.reason || 'Workflow planned action.'), input: { action: explicitName, actionInput: nextInput }, depends_on: Array.isArray(action.depends_on) ? action.depends_on : [] };\n});\nconst finalActionId = String(plan.final_action_id || plan.finalActionId || payload.final_action_id || payload.finalActionId || actions[actions.length - 1]?.id || '').trim();\nreturn { ...payload, plan: { ...(plan || {}), actions, final_action_id: finalActionId, finalActionId }, __activeOutputs: ['output'] };"}})
(executeGovernor:ai-governor {"name":"Execute Approved Plan","runtime":{"executionMode":"execute-plan","selectionPromptMd":"Execute the approved router plan exactly as provided."}})
(pendingClear:current-chat {"name":"Clear Pending Plan","runtime":{"mode":["pending"],"pendingAction":"clear"}})
(readSubject:run-subject-action {"name":"Subject Read For SERP","runtime":{"action":"read_subject","message":"{{workflow.metadata.message}}","chatId":"{{workflow.metadata.chatId}}","subjectIds":"{{workflow.metadata.subjectIds}}","actionInput":{"id":"{{workflow.metadata.subjectIds.0}}"}}})
(buildSerpQuery:code {"name":"Build SERP Query","runtime":{"code":"const meta = workflow.metadata || {};\nconst subject = Object.values(input)[0] || {};\nconst action = subject.action || subject.output?.action || {};\nconst data = action.data || {};\nconst item = data.subject || data || {};\nconst tags = Array.isArray(item.tags) ? item.tags.join(' ') : '';\nconst query = [item.name, item.description, tags, meta.message, 'official references guide'].filter(Boolean).join(' ');\nreturn { query, max_results: 5 };"}})
(serp:serp-search {"name":"SERP Subject References","runtime":{"query":"{{input.query}}","max_results":5,"location":"United States","language":"en"}})
(buildSubjectUpdate:code {"name":"Build Subject Reference Update","runtime":{"code":"const meta = workflow.metadata || {};\nconst values = Object.values(input);\nconst source = values[0] || {};\nconst items = source.items || source.results || source.output?.items || [];\nconst links = items.map((entry) => ({ title: entry.title || '', url: entry.link || entry.url || '', snippet: entry.snippet || '', source: entry.source || 'serp', discovered_at: new Date().toISOString() }));\nreturn { plan: { intent: 'Update subject references from visible SERP results.', actions: [{ id: 'subject_reference_update', name: 'update_subject', reason: 'Write normalized SERP links into subject metadata.', input: { id: (meta.subjectIds || [])[0], metadata: { agent_references: { links, last_synced_at: new Date().toISOString(), source: 'workflow.serp-search' } } }, depends_on: [] }] } };"}})
(referencePolicy:chat-plan-policy {"name":"Reference Sync Planner","runtime":{"confirmationPolicy":"mutations-only","validationPolicy":"ignore-validation","emptyPlanBehavior":"fail","confirmedWithoutPendingBehavior":"no-pending"}})
(formatMerge:merge {"name":"Merge Response Inputs","runtime":{}})
(responseContext:code {"name":"Build Response Context","runtime":{"code":"const objects = [];\nconst collect = (value) => {\n  if (!value || typeof value !== 'object') return;\n  objects.push(value);\n  const values = Array.isArray(value) ? value : Object.values(value);\n  values.forEach((entry) => collect(entry));\n};\ncollect(Object.values(input)[0] || {});\nconst find = (predicate) => objects.find((entry) => predicate(entry)) || {};\nconst compactValidation = (value) => {\n  if (!value || typeof value !== 'object') return null;\n  const workflow = value.workflow && typeof value.workflow === 'object' ? value.workflow : {};\n  return {\n    ok: value.ok === true,\n    errors: Array.isArray(value.errors) ? value.errors : [],\n    warnings: Array.isArray(value.warnings) ? value.warnings : [],\n    cypher: String(value.cypher || '').trim() || null,\n    node_count: Array.isArray(workflow.nodes) ? workflow.nodes.length : null,\n    connection_count: Array.isArray(workflow.connections) ? workflow.connections.length : null\n  };\n};\nconst compactAction = (entry) => {\n  if (!entry || typeof entry !== 'object') return {};\n  const data = entry.data && typeof entry.data === 'object' ? entry.data : {};\n  const workflow = data.workflow && typeof data.workflow === 'object'\n    ? {\n        id: String(data.workflow.id || data.workflow.workflow_id || '').trim() || null,\n        name: String(data.workflow.name || '').trim() || null,\n        editor_url: String(data.workflow.editor_url || data.editor_url || '').trim() || null\n      }\n    : null;\n  return {\n    id: String(entry.id || '').trim() || null,\n    name: String(entry.name || '').trim(),\n    status: String(entry.status || '').trim() || null,\n    summary: String(entry.summary || '').trim() || null,\n    error: String(entry.error || '').trim() || null,\n    data: {\n      text: String(data.text || '').trim() || null,\n      output: Object.prototype.hasOwnProperty.call(data, 'output') ? data.output : null,\n      editor_url: String(data.editor_url || (workflow && workflow.editor_url) || '').trim() || null,\n      workflow,\n      workflow_id: String(data.workflow_id || (workflow && workflow.id) || '').trim() || null,\n      channel_id: String(data.channel_id || '').trim() || null,\n      category_id: String(data.category_id || '').trim() || null,\n      subject_id: String(data.subject_id || '').trim() || null,\n      post_id: String(data.post_id || '').trim() || null\n    }\n  };\n};\nconst workflowOutputNames = ['execute_workflow', 'get_workflow_output', 'Execute Workflow'];\nconst router = find((entry) => Array.isArray(entry.action_results));\nconst pending = find((entry) => entry.requires_confirmation === true || Array.isArray(entry.pending_actions));\nconst planningFailure = find((entry) => entry.response_format === 'planning_failure');\nconst planner = find((entry) => entry.plan && Array.isArray(entry.plan.actions));\nconst actionResults = (Array.isArray(router.action_results) ? router.action_results : []).map(compactAction);\nconst workflowResult = actionResults.find((entry) => entry && workflowOutputNames.includes(String(entry.name || '').trim())) || {};\nconst workflowData = workflowResult.data || {};\nconst responseFormat = pending.requires_confirmation === true ? 'confirmation_request' : workflowResult.name ? 'workflow_output' : String(planningFailure.response_format || planner.response_format || (actionResults.length ? 'action_summary' : 'plain_text'));\nreturn {\n  plan: router.plan || pending.plan || planner.plan || { intent: '', actions: [] },\n  action_results: actionResults,\n  requires_confirmation: pending.requires_confirmation === true,\n  pending_actions: pending.pending_actions || null,\n  response_format: responseFormat,\n  interaction: pending.interaction || null,\n  workflow_cypher: pending.workflow_cypher || null,\n  workflow_validation: compactValidation(pending.workflow_validation || planningFailure.validation || planner.validation || null),\n  workflow_execution_output: Object.prototype.hasOwnProperty.call(workflowData, 'output') ? workflowData.output : workflowData.text || null,\n  workflow_execution_text: String(workflowData.text || '').trim(),\n  workflow_editor_url: String(workflowData.editor_url || (workflowData.workflow && workflowData.workflow.editor_url) || '').trim(),\n  text: String(pending.markdown || pending.text || planningFailure.markdown || planningFailure.text || '').trim(),\n  __activeOutputs: ['output']\n};"}})
(responseDraft:code {"name":"Build Response Draft","runtime":{"code":"const state = Object.values(input)[0] || {};\nconst actionResults = Array.isArray(state.action_results) ? state.action_results : [];\nconst responseFormat = String(state.response_format || (actionResults.length ? 'action_summary' : 'plain_text'));\nconst workflowOutputNames = ['execute_workflow', 'get_workflow_output', 'Execute Workflow'];\nconst workflowTextValue = (value) => {\n  if (typeof value === 'string' && value.trim()) return value.trim();\n  if (!value || typeof value !== 'object' || Array.isArray(value)) return '';\n  for (const key of ['text', 'markdown', 'value', 'output']) {\n    const candidate = value[key];\n    if (typeof candidate === 'string' && candidate.trim()) return candidate.trim();\n  }\n  return '';\n};\nconst factLine = (entry) => {\n  if (!entry || !entry.name) return '';\n  if (entry.status === 'failed' || entry.error) return `${entry.name}: failed - ${entry.error || entry.summary || 'execution failed'}`;\n  const data = entry.data || {};\n  if (workflowOutputNames.includes(String(entry.name || '').trim()) && (data.text || data.output)) return `${entry.name}: ${data.text || workflowTextValue(data.output) || JSON.stringify(data.output, null, 2)}`;\n  if (data.text) return `${entry.name}: ${String(data.text).trim()}`;\n  if (data.workflow && (data.workflow.name || data.workflow.id)) return `${entry.name}: workflow ${data.workflow.name || data.workflow.id}`;\n  const resourceIds = [data.channel_id && `channel ${data.channel_id}`, data.category_id && `category ${data.category_id}`, data.subject_id && `subject ${data.subject_id}`, data.workflow_id && `workflow ${data.workflow_id}`].filter(Boolean);\n  if (resourceIds.length) return `${entry.name}: completed (${resourceIds.join(', ')})`;\n  if (entry.summary) return `${entry.name}: ${entry.summary}`;\n  return `${entry.name}: ${entry.status || 'completed'}`;\n};\nconst facts = actionResults.map(factLine).filter(Boolean);\nconst draftText = String(state.text || '').trim();\nconst actionText = facts.join('\\n\\n');\nconst workflowText = String(state.workflow_execution_text || '').trim() || workflowTextValue(state.workflow_execution_output);\nconst workflowEditorUrl = String(state.workflow_editor_url || '').trim();\nconst workflowDraft = workflowText ? `${workflowText}${workflowEditorUrl ? `\\n\\n[Open workflow](${workflowEditorUrl})` : ''}` : '';\nconst draft = responseFormat === 'workflow_output' ? workflowDraft || actionText || 'No action output was generated.' : draftText || (actionText ? `I ran ${actionResults.length} workflow action${actionResults.length === 1 ? '' : 's'}:\\n\\n${actionText}` : 'No action output was generated.');\nreturn { response_format: responseFormat, requires_confirmation: state.requires_confirmation === true, rule: responseFormat === 'workflow_output' ? 'Return the executed workflow output exactly as provided. Do not summarize or invent missing output.' : 'Use only the provided facts and draft. Do not invent missing ids, unread posts, causes, or failures unless they are explicitly listed.', facts, draft, workflow_execution_output: state.workflow_execution_output || null, __activeOutputs: ['output'] };"}})
(formatInput:code {"name":"Build Format Input","runtime":{"code":"const state = Object.values(input)[0] || {};\nconst responseFormat = String(state.response_format || '').trim();\nconst draft = String(state.draft || '').trim();\nif (responseFormat === 'workflow_output' || responseFormat === 'planning_failure' || responseFormat === 'confirmation_request') return { response_format: responseFormat, use_ai: false, direct_text: draft, ai_input: null };\nreturn { response_format: responseFormat, use_ai: true, direct_text: '', ai_input: { rule: String(state.rule || '').trim(), facts: Array.isArray(state.facts) ? state.facts : [], draft } };"}})
(formatGate:if-else {"name":"Use AI Response Formatting?","runtime":{"value":"{{code-36}}","code":"const source = Object.values(input)[0] || {};\nreturn source.use_ai === true ? { true: source } : { false: String(source.direct_text || '').trim() }; "}})
(prepareAiFormat:code {"name":"Prepare AI Format Input","runtime":{"code":"const source = Object.values(input)[0] || {};\nconst branch = source.trueBranch && source.trueBranch.value ? source.trueBranch.value : source;\nreturn branch.ai_input || {};"}})
(format:output-format {"name":"Giga Chat Response","runtime":{"format":"markdown","useAiFormatting":true,"aiPrompt":"Write the final chat response for the user using only the provided draft and facts. Do not infer missing ids, unread posts, or execution failures unless they are explicitly listed. When the draft is already a complete confirmation or action summary, preserve its meaning and keep the wording grounded. Return concise markdown only."}})
(formatModel:openai {"name":"Response LLM","runtime":{"model":"gpt-4.1-mini","temperature":0.2,"prompt":"Format the workflow chat response."}})
(payloadMerge:merge {"name":"Merge Response Payload","runtime":{}})
(responsePayload:code {"name":"Build Chat Response Payload","runtime":{"code":"const objects = [];\nconst strings = [];\nconst collect = (value) => {\n  if (typeof value === 'string' && value.trim()) {\n    strings.push(value.trim());\n    return;\n  }\n  if (!value || typeof value !== 'object') return;\n  objects.push(value);\n  const values = Array.isArray(value) ? value : Object.values(value);\n  values.forEach((entry) => collect(entry));\n};\ncollect(input);\nconst find = (predicate) => objects.find((entry) => predicate(entry)) || {};\nconst compactPlan = (value) => {\n  const plan = value && typeof value === 'object' ? value : {};\n  const actions = Array.isArray(plan.actions) ? plan.actions : [];\n  return {\n    intent: String(plan.intent || '').trim(),\n    actions: actions.map((action, index) => ({\n      id: String(action.id || `a${index + 1}`).trim() || `a${index + 1}`,\n      name: String(action.name || 'workflow_action').trim() || 'workflow_action',\n      reason: String(action.reason || 'Workflow planned action.').trim() || 'Workflow planned action.',\n      input: action.input || {},\n      depends_on: Array.isArray(action.depends_on) ? action.depends_on : []\n    }))\n  };\n};\nconst compactPassPlan = (value) => {\n  const plan = compactPlan(value);\n  return {\n    intent: plan.intent,\n    actions: plan.actions.map((action) => ({\n      id: action.id,\n      name: action.name,\n      reason: action.reason,\n      depends_on: action.depends_on\n    }))\n  };\n};\nconst workflowOutputNames = ['execute_workflow', 'get_workflow_output', 'Execute Workflow'];\nconst responseEntry = find((entry) => entry.response_format);\nconst router = find((entry) => Array.isArray(entry.action_results));\nconst pending = find((entry) => entry.requires_confirmation === true || Array.isArray(entry.pending_actions));\nconst workflowEntry = find((entry) => Object.prototype.hasOwnProperty.call(entry, 'workflow_execution_output'));\nconst markdown = strings[0] || String(responseEntry.draft || responseEntry.text || 'Workflow completed.').trim();\nconst plan = compactPlan(responseEntry.plan || router.plan || pending.plan || { intent: '', actions: [] });\nconst actionResults = (Array.isArray(responseEntry.action_results) ? responseEntry.action_results : Array.isArray(router.action_results) ? router.action_results : []).map((entry, index) => ({\n  id: String(entry?.id || `r${index + 1}`).trim() || `r${index + 1}`,\n  name: String(entry?.name || 'workflow_action').trim() || 'workflow_action',\n  status: String(entry?.status || 'completed').trim() || 'completed',\n  reason: String(entry?.reason || 'Workflow action completed.').trim() || 'Workflow action completed.',\n  summary: String(entry?.summary || `${String(entry?.name || 'workflow_action').trim() || 'workflow_action'}: ${String(entry?.status || 'completed').trim() || 'completed'}`).trim(),\n  error: String(entry?.error || '').trim() || null,\n  duration_ms: Number.isFinite(Number(entry?.duration_ms)) ? Number(entry.duration_ms) : 0,\n  data: entry?.data && typeof entry.data === 'object' ? entry.data : {}\n}));\nconst workflowResult = actionResults.find((entry) => entry && workflowOutputNames.includes(String(entry.name || '').trim())) || {};\nconst workflowExecutionOutput = Object.prototype.hasOwnProperty.call(workflowEntry, 'workflow_execution_output') ? workflowEntry.workflow_execution_output : workflowResult.data ? (Object.prototype.hasOwnProperty.call(workflowResult.data, 'output') ? workflowResult.data.output : workflowResult.data.text || null) : null;\nconst responseFormat = String(responseEntry.response_format || (actionResults.some((entry) => entry && workflowOutputNames.includes(String(entry.name || '').trim())) ? 'workflow_output' : actionResults.length ? 'action_summary' : 'plain_text'));\nreturn {\n  markdown,\n  text: markdown,\n  sources: [],\n  retrieved_chunks: [],\n  agent: {\n    intent: plan.intent || '',\n    plan,\n    action_results: actionResults,\n    response_format: responseFormat,\n    requires_confirmation: pending.requires_confirmation === true,\n    pending_actions: pending.pending_actions || null,\n    pipeline_passes: [{\n      kind: pending.requires_confirmation === true ? 'confirmation_request' : 'initial',\n      plan: compactPassPlan(plan),\n      action_results: actionResults.map((entry) => ({\n        id: entry.id,\n        name: entry.name,\n        status: entry.status,\n        summary: entry.summary,\n        error: entry.error\n      })),\n      response_format: responseFormat\n    }],\n    interaction: pending.interaction || null,\n    workflow_cypher: pending.workflow_cypher || null,\n    workflow_validation: responseEntry.workflow_validation || pending.workflow_validation || null,\n    workflow_execution_output: workflowExecutionOutput\n  },\n  __activeOutputs: ['output']\n};"}})

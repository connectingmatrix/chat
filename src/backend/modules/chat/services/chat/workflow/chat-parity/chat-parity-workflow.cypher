(confirmedMerge:merge {"name":"Merge Confirmed Input","runtime":{}})
(confirmedPolicy:chat-plan-policy {"name":"Confirmed Planner","runtime":{"confirmationPolicy":"mutations-only","validationPolicy":"ignore-validation","emptyPlanBehavior":"fail","confirmedWithoutPendingBehavior":"no-pending"}})
(referenceGate:if-else {"name":"Reference Sync?","runtime":{"value":"{{if-else-8}}","leftPath":"referenceSyncIntent","operator":"truthy","code":"const source = Object.values(input)[0] || input;\nconst data = source.falseBranch?.value || source.output || source;\nreturn data.referenceSyncIntent ? { true: data } : { false: data };"}})
(governorInput:code {"name":"Build Governor Input","runtime":{"code":"const source = Object.values(input)[0] || input;\nconst data = source.falseBranch?.value || source.output || source;\nconst message = String(data.normalized_message || data.message || data.original_message || '').trim();\nconst lower = message.toLowerCase();\nconst workflowRequestIntent = data.workflowRequestIntent === true || /\\bworkflow\\b/.test(lower) && /\\b(create|build|make|update|write|edit|replace|run|execute|cypher|code)\\b/.test(lower);\nconsole.log(JSON.stringify({ governor_input_debug: { message, workflowRequestIntent, analysisSummary: String(data.analysisSummary || ''), incomingWorkflowRequestIntent: data.workflowRequestIntent === true, keys: Object.keys(data || {}) } }));\nreturn { ...data, message, normalized_message: message || String(data.normalized_message || '').trim(), workflowRequestIntent, workflowFollowupIntent: data.workflowFollowupIntent === true, mutationIntent: data.mutationIntent === true, explanationIntent: data.explanationIntent === true, referenceSyncIntent: data.referenceSyncIntent === true, confirmed: data.confirmed === true, __activeOutputs: ['output'] };"}})
(governor:ai-governor {"name":"Chat Planner","runtime":{"executionMode":"plan-only","selectionPromptMd":"You are the workflow-native Giga chat planner. Do not execute tools. Return strict JSON only with {\"intent\":\"string\",\"actions\":[{\"id\":\"a1\",\"nodeId\":\"connected tool node id\",\"kind\":\"tool\",\"reason\":\"why\",\"input\":{},\"depends_on\":[]}],\"final_action_id\":\"a1\"}. Use connected tool nodes only. Action Router tools are for grouped backend actions and require input.action plus optional input.actionInput. Workflow is the workflow authoring tool. Use input.operation with list, get, save, delete, or publish. Workflow save in chat requires input.workflowName, input.cypher, input.definitionSource set to cypher, and input.publishAfterSave set to true when the user wants to create and run a workflow. Execute Workflow runs one published workflow and accepts either input.workflowId or input.workflowActionId. If executing a newly saved workflow, set Execute Workflow input.workflowActionId to the prior Workflow action id and depends_on to that same action id. When workflowRequestIntent is true, the first planned action must be Workflow and the plan must finish with Execute Workflow. Requests to create a workflow and run it, including typo-heavy variants like ouput/output, must plan Workflow followed by Execute Workflow. When the user asks for a workflow that returns, prints, says, greets with, or outputs literal text, put the full executable Workflow Cypher in input.cypher and keep the requested wording dynamic instead of hardcoding a single example. Use valid Workflow Cypher JSON with double-quoted keys and string values. For simple output workflows, use only the model ids start, code, and respond-end. Every node line must match (alias:modelId {\"name\":\"Name\",\"runtime\":{...}}). Every connection line must match (from)-[:CONNECT {\"source\":\"out:output\",\"target\":\"in:input\"}]->(to). Do not invent model ids like StartNode, CodeNode, or RespondEndNode. Put each node declaration and each CONNECT edge on its own separate line in input.cypher. Do not chain node and edge declarations on one line. For literal-output workflows, use runtime code in the form return { text: \"requested text\" }; with double-quoted text, not template literals or backticks. Never emit shorthand like Start => Code => End or property assignment lines like Code.code = ... For subject reference sync, prefer the explicit Subject read -> SERP -> Subject update workflow path instead of direct sync_subject_references_from_web. Mutating actions must still be planned; Planner will request confirmation before approved tools execute them. Respect required ids. Never plan read_post, update_post, delete_post, or read_attachments unless postIds are present or actionInput already contains an explicit post id. Never plan read_subject, update_subject, delete_subject, or refresh subject links unless subjectIds are present or actionInput already contains an explicit subject id. When scopeType is channel and the user asks for explanation, understanding, or clarification, prefer read_channel or fetch_user_tree before post or subject mutations unless workflowRequestIntent is true. If an id is missing, choose a different valid action instead of emitting an invalid one."}})
(plannerModel:openai {"name":"Planner LLM","runtime":{"model":"gpt-4.1-mini","temperature":0.05,"prompt":"Return strict JSON only for the AI Governor planner."}})
(repairCypher:code {"name":"Repair Planned Workflow Cypher","runtime":{"code":"const records = [];\nconst collect = (value) => {\n  if (!value || typeof value !== 'object') return;\n  if (Array.isArray(value)) {\n    value.forEach(collect);\n    return;\n  }\n  records.push(value);\n  Object.values(value).forEach(collect);\n};\ncollect(input);\nconst payload = records.find((entry) => entry && entry.plan && Array.isArray(entry.plan.actions)) || records.find((entry) => Array.isArray(entry.actions) && String(entry.final_action_id || entry.finalActionId || '').trim()) || {};\nconst plan = payload.plan && Array.isArray(payload.plan.actions) ? payload.plan : Array.isArray(payload.actions) ? payload : { intent: '', actions: [] };\nconst nodeList = Array.isArray(workflow.nodes) ? workflow.nodes : [];\nconst nodeById = Object.fromEntries(nodeList.map((node) => [String(node.id || '').trim(), String(node.modelId || '').trim()]));\nconst normalizeCypher = (value) => {\n  let text = String(value || '').trim();\n  if (!text) return text;\n  text = text.replace(/^CREATE\\s+/i, '').replace(/\\s+RETURN\\s+[\\s\\S]*$/i, '').trim();\n  text = text.replace(/\\s+CREATE\\s+/gi, '\\n');\n  text = text.replace(/([A-Za-z_][\\w-]*)\\.(?:out|output):(?:output)/g, '$1.output');\n  text = text.replace(/([A-Za-z_][\\w-]*)\\.(?:in|input):(?:input)/g, '$1.input');\n  text = text.replace(/,?\\s*CONNECT\\s+([A-Za-z_][\\w-]*)(?:[.:](?:output|out))\\s+TO\\s+([A-Za-z_][\\w-]*)(?:[.:](?:input|in))/gi, (_match, from, to) => `\\n(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/,?\\s*CONNECT\\s+([A-Za-z_][\\w-]*)(?:[.:](?:output|out))?\\s*->\\s*([A-Za-z_][\\w-]*)(?:[.:](?:input|in))?/gi, (_match, from, to) => `\\n(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/\\{\\s*out:\\s*\\\"([^\\\"]+)\\\"\\s*,\\s*in:\\s*\\\"([^\\\"]+)\\\"\\s*\\}/g, (_match, sourcePort, targetPort) => `{\\\"source\\\":\\\"out:${sourcePort}\\\",\\\"target\\\":\\\"in:${targetPort}\\\"}`);\n  text = text.replace(/\\(([A-Za-z_][\\w-]*)\\)-\\[:(?:CONNECT|NEXT)\\]->\\(([A-Za-z_][\\w-]*)\\)/g, (_match, from, to) => `(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/([A-Za-z_][\\w-]*)-\\[:(?:CONNECT|NEXT)\\]->([A-Za-z_][\\w-]*)/g, (_match, from, to) => `(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  text = text.replace(/\\),\\s+\\(/g, ')\\n(');\n  text = text.replace(/\\)\\s+\\(([A-Za-z_][\\w-]*:)/g, ')\\n($1');\n  text = text.replace(/,\\s*([A-Za-z_][\\w-]*)(?:[.:](?:output|out))?\\s*->\\s*([A-Za-z_][\\w-]*)(?:[.:](?:input|in))?/g, (_match, from, to) => `\\n(${from})-[:CONNECT {\\\"source\\\":\\\"out:output\\\",\\\"target\\\":\\\"in:input\\\"}]->(${to})`);\n  return text;\n};\nconst actions = (plan.actions || []).map((entry) => {\n  const action = entry || {};\n  const nextInput = { ...(action.input || {}) };\n  const nextActionInput = { ...(nextInput.actionInput || {}) };\n  const requestedNodeId = String(action.nodeId || '').trim();\n  const resolvedNode = nodeList.find((node) => String(node.id || '').trim() === requestedNodeId || String(node.name || '').trim() === requestedNodeId || String(node.modelId || '').trim() === requestedNodeId) || {};\n  const resolvedNodeId = String(resolvedNode.id || requestedNodeId).trim();\n  const modelId = String(resolvedNode.modelId || nodeById[resolvedNodeId] || '').trim();\n  const name = String(action.name || action.action || nextInput.action || resolvedNode.name || (modelId === 'workflow' ? 'Workflow' : modelId === 'execute-workflow' ? 'Execute Workflow' : '')).trim();\n  if ((name === 'Workflow' || modelId === 'workflow') && nextInput.cypher) nextInput.cypher = normalizeCypher(nextInput.cypher);\n  if ((name === 'Workflow' || modelId === 'workflow') && nextInput.name && !nextInput.workflowName) nextInput.workflowName = nextInput.name;\n  if ((name === 'Workflow' || modelId === 'workflow') && nextInput.description && !nextInput.workflowDescription) nextInput.workflowDescription = nextInput.description;\n  if ((name === 'Execute Workflow' || modelId === 'execute-workflow') && nextInput.workflow_id && !nextInput.workflowId) nextInput.workflowId = nextInput.workflow_id;\n  if ((name === 'Execute Workflow' || modelId === 'execute-workflow') && nextInput.workflow_action_id && !nextInput.workflowActionId) nextInput.workflowActionId = nextInput.workflow_action_id;\n  if (Object.keys(nextActionInput).length) nextInput.actionInput = nextActionInput;\n  return { ...action, nodeId: resolvedNodeId, name, input: nextInput };\n});\nconsole.log(JSON.stringify({ repair_planned_workflow_debug: { planner_source: String(payload.planner_source || plan.source || 'ai_governor').trim() || 'ai_governor', action_count: actions.length, action_names: actions.map((entry) => String(entry.name || '').trim()) } }));\nreturn { ...payload, planner_source: String(payload.planner_source || plan.source || 'ai_governor').trim() || 'ai_governor', normalized_message: String(payload.normalized_message || payload.message || workflow.metadata?.message || '').trim(), plan: { ...plan, source: String(plan.source || payload.planner_source || 'ai_governor'), actions }, __activeOutputs: ['output'] };"}})

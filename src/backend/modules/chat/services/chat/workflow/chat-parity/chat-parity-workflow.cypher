(chatInput:current-chat {"name":"Chat Input","runtime":{"mode":["input","context"]}})
(typoInput:code {"name":"Build Planner Message Correction Input","runtime":{"code":"const source = Object.values(input)[0] || {};\nconst message = String(source.message || '').trim();\nconsole.log(JSON.stringify({ planner_message_input_debug: { message, keys: Object.keys(source || {}) } }));\nif (!message) throw new Error('Chat input message is required for planner typo correction.');\nreturn { task: 'Correct only spelling and obvious transcription mistakes in the user message. Do not change intent, scope, names, ids, requested actions, or tone. Preserve names like Rich. Return strict JSON only.', original_message: message, output_contract: { original_message: 'string', normalized_message: 'string', corrections: ['string'] }, __activeOutputs: ['output'] };"}})
(typoFixer:openai {"name":"Normalize Planner Message","runtime":{"model":"gpt-4.1-mini","temperature":0}})
(typoParse:code {"name":"Parse Normalized Planner Message","runtime":{"code":"const source = Object.values(input)[0] || {};\nconst raw = String(source.text || source.markdown || source.output_text || source.raw?.output_text || '').trim();\nif (!raw) throw new Error('Planner typo correction returned empty output.');\nconst jsonText = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(jsonText); } catch { throw new Error('Planner typo correction returned invalid JSON.'); }\nconst original_message = String(parsed.original_message || '').trim();\nconst normalized_message = String(parsed.normalized_message || '').trim();\nconst corrections = Array.isArray(parsed.corrections) ? parsed.corrections.map((entry) => String(entry || '').trim()).filter(Boolean) : [];\nconsole.log(JSON.stringify({ planner_message_parse_debug: { original_message, normalized_message, corrections } }));\nif (!original_message || !normalized_message) throw new Error('Planner typo correction must return original_message and normalized_message.');\nreturn { original_message, normalized_message, message: normalized_message, corrections, __activeOutputs: ['output'] };"}})
(analysisMerge:merge {"name":"Merge Chat Analysis Input","runtime":{}})
(textAnalysis:text-analysis {"name":"Text Analysis","runtime":{"analysisKinds":["confirmation","mutation","workflow-request","workflow-followup","reference-sync","explanation"]}})
(confirmedGate:if-else {"name":"Confirmed?","runtime":{"value":"{{text-analysis-7}}","leftPath":"confirmed","operator":"truthy","code":"const records = [];\nconst collect = (value) => {\n  if (!value || typeof value !== 'object') return;\n  if (Array.isArray(value)) {\n    value.forEach(collect);\n    return;\n  }\n  records.push(value);\n  Object.values(value).forEach(collect);\n};\ncollect(input);\nconst data = records.find((entry) => entry.confirmed === true) || records.find((entry) => Object.prototype.hasOwnProperty.call(entry, 'confirmed')) || records[0] || {};\nconst messageSource = records.find((entry) => String(entry.normalized_message || entry.message || entry.original_message || '').trim()) || {};\nconst message = String(messageSource.normalized_message || messageSource.message || messageSource.original_message || '').trim();\nconst confirmed = data.confirmed === true || /^(yes|y|confirm|confirmed|approve|approved|proceed|go ahead|do it|run it|execute|confirm all changes)$/i.test(message);\nconst result = confirmed ? { ...data, confirmed: true } : data;\nreturn confirmed ? { true: result } : { false: result };"}})

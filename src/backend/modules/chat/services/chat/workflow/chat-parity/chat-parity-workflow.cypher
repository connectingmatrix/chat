(executeWorkflowTool:execute-workflow {"name":"Execute Workflow","runtime":{"executionSource":"input-workflow-id"}})
(chatTool:run-chat-action {"name":"Chat","runtime":{"action":"search_web_with_tags","message":"{{workflow.metadata.message}}","chatId":"{{workflow.metadata.chatId}}"}})

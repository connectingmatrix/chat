{
  "name": "@connectingmatrix/chat",
  "version": "0.2.0",
  "description": "Single complete chat package owning connectingmatrix and Giga chat APIs: queryChat/queryChaat, sockets, attachments, modes, dataloaders, GraphQL, and entity CRUD.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    },
    "./entity": {
      "types": "./dist/entity/index.d.ts",
      "import": "./dist/entity/index.js"
    },
    "./package.json": "./package.json",
    "./giga": {
      "types": "./dist/giga/index.d.ts",
      "import": "./dist/giga/index.js"
    },
    "./package-structure": {
      "types": "./dist/package-structure.d.ts",
      "import": "./dist/package-structure.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./frontend": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "README.md",
    "tests",
    "vendor",
    "PACKAGE_STRUCTURE.json",
    "PACKAGE_STRUCTURE.md",
    "playground.mjs",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "play": "npm run build && node playground.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "sideEffects": false,
  "license": "UNLICENSED"
}
